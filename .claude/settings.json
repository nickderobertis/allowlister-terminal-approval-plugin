{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just setup-llmlint)",
      "Bash(just lint-llm)",
      "Bash(just lint-llm-diff:*)",
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just test-cov)",
      "Bash(just lint)",
      "Bash(just fmt-check)",
      "Bash(just format)",
      "Bash(just typecheck)",
      "Bash(just deps-check)",
      "Bash(just security)",
      "Bash(just doc)",
      "Bash(just build)",
      "Bash(just build-release)",
      "Bash(just upgrade)",
      "Bash(just run:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo build:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo machete)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": []
  }
}
